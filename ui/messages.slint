import {HorizontalBox, VerticalBox } from "std-widgets.slint";

// === DBC Editor Data Structures ===

// Signal data for editing in DBC editor
export struct EditableSignalData {
    index: int,
    name: string,
    start_bit: int,
    signal_size: int,
    byte_order: int,      // 0=little-endian, 1=big-endian
    value_type: int,      // 0=unsigned, 1=signed
    factor: string,       // Use string for float display
    offset: string,
    min_val: string,
    max_val: string,
    unit: string,
}

// Message data for editing in DBC editor
export struct EditableMessageData {
    index: int,
    message_id: string,   // Hex string "0x7E8" format
    is_extended: bool,
    name: string,
    dlc: int,
    transmitter: string,
    signal_count: int,
}

// Compact signal info for list display
export struct SignalListItem {
    index: int,
    name: string,
    start_bit: int,
    size: int,
    unit: string,
}

// === CAN Viewer Data Structures ===

export struct CanSignal {
    signal_name: string,
    signal_value: string,
    unit: string,
    factor: string,
}

export struct CanData {
    can_id: string,
    packet_name: string,
    raw_can: string,
    counter: int,
    time_stamp: string,
    circle_time: string,
    signal_value: [CanSignal],
    color: color
}

export component CanMessage inherits VerticalLayout {
    in property <string> message_id: "0x00000000";
    in property <string> raw_data: "0x01 0x02 0x03 0x04";
    in property <string> message_name: "packet_xxx";
    in property <int> counter: 0;
    in property <string> circle_time: 0;
    in property <color> back_ground;
    in property <[CanSignal]> signals: [
        {signal_name: "signal_1", signal_value: "100", unit: "Hz", factor: "1.0", circle_time: "1 ms"},
        {signal_name: "signal_2", signal_value: "999", unit: "Km", factor: "1.0", circle_time: "1 ms"},
        {signal_name: "signal_3", signal_value: "203", unit: "second", factor: "1.0", circle_time: "1 ms"},
        {signal_name: "signal_4", signal_value: "15.6", unit: "mWh", factor: "1.0", circle_time: "1 ms"},
        {signal_name: "signal_5", signal_value: "20.9", unit: "A", factor: "1.0", circle_time: "1 ms"},
        {signal_name: "signal_6", signal_value: "10", unit: "Volt", factor: "1.0", circle_time: "1 ms"},
        {signal_name: "signal_7", signal_value: "1", unit: "mA", factor: "1.0", circle_time: "1 ms"}];
        height: (signals.length < 3)? 75px: signals.length * 25px;
    Rectangle {
        background: back_ground;
        HorizontalLayout{
            Rectangle {
                width: root.width * 20%;
                border-color: white;
                border-width: 0.25px;
                Text {
                    text: root.message_id + "\n" + root.message_name + "\n" + root.counter;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: white;
                }   
            }
        
            VerticalLayout {
                for signal in signals: HorizontalLayout { 
                    Rectangle {
                        width: root.width * 25%;
                        border-color: white;
                        border-width: 0.25px;
                        Text {
                            text: signal.signal_name;
                            color: white;
                        }  
                    }
                    Rectangle {
                        width: root.width * 15%;
                        border-color: white;
                        border-width: 0.25px;
                        Text {
                            text: signal.signal_value + " " + signal.unit;
                            color: white;
                        }  
                    }
                }
            }
        
            Rectangle {
                width: root.width * 30%;
                border-color: white;
                border-width: 0.25px;
                Text {
                    text: root.raw_data;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: white;
                }   
            }
            Rectangle {
                width: root.width * 10%;
                border-color: white;
                border-width: 0.25px;
                Text {
                    text: root.circle_time;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: white;
                }   
            }
        }
    }
}
